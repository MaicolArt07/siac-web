---
export interface Props {
  current?: string;
  overlay?: boolean;
}
const { current = '', overlay = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const services = [
  { href: `${base}administracion`, label: 'Administración', key: 'administracion' },
  { href: `${base}seguridad`, label: 'Seguridad', key: 'seguridad' },
  { href: `${base}limpieza`, label: 'Limpieza', key: 'limpieza' },
  { href: `${base}jardineria`, label: 'Jardinería', key: 'jardineria' },
  { href: `${base}mantenimiento`, label: 'Mantenimiento', key: 'mantenimiento' },
];
const inServices = services.some((s) => s.key === current);
const cur = (key: string) => (current === key ? 'page' : undefined);
---
<header class:list={['site-header', { 'is-overlay': overlay }]} data-header>
  <div class="header-bar">
    <nav class="header-left nav-desktop" aria-label="Principal">
      <a class="nav-link" href={base} aria-current={cur('inicio')}>Inicio</a>
      <a class="nav-link" href={`${base}nosotros`} aria-current={cur('nosotros')}>Nosotros</a>
      <div class="nav-drop">
        <button type="button" class="nav-link nav-drop-btn" aria-expanded="false" aria-haspopup="true" data-current={inServices ? 'true' : undefined}>
          Servicios
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <ul class="nav-drop-menu">
          {services.map((s) => (
            <li><a href={s.href} aria-current={cur(s.key)}>{s.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-mobile">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <a href={base} class="brand">
      <img class="brand-logo" src={`${base}logo/logo-horizontal.png`} alt="SIAC — Servicios Integrales en Administración de Condominios">
    </a>

    <div class="header-right">
      <nav class="nav-desktop" aria-label="Secundaria">
        <a class="nav-link" href={`${base}contacto`} aria-current={cur('contacto')}>Contáctenos</a>
        <button type="button" class="nav-link nav-link-btn" data-contact-open aria-haspopup="dialog" aria-controls="contact-modal">Cotizar</button>
      </nav>
      <button type="button" id="theme-toggle" class="icon-btn theme-toggle" aria-label="Cambiar tema claro/oscuro">
        <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.5A8.5 8.5 0 1111.5 3 7 7 0 0021 12.5z"/></svg>
      </button>
      <a class="nav-pill" href={`${base}condominios`} aria-current={cur('condominios')}>Condominios</a>
    </div>
  </div>

  <div class="nav-mobile" id="nav-mobile">
    <ul>
      <li><a href={base}>Inicio</a></li>
      <li><a href={`${base}nosotros`}>Nosotros</a></li>
      {services.map((s) => (<li><a href={s.href}>{s.label}</a></li>))}
      <li><a href={`${base}contacto`}>Contáctenos</a></li>
      <li><a class="nav-cta" href={`${base}condominios`}>Ver Condominios</a></li>
    </ul>
  </div>
</header>
