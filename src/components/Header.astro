---
export interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { href: base, label: 'Inicio', key: 'inicio' },
  { href: `${base}nosotros`, label: 'Nosotros', key: 'nosotros' },
  { href: `${base}administracion`, label: 'Administración', key: 'administracion' },
  { href: `${base}seguridad`, label: 'Seguridad', key: 'seguridad' },
  { href: `${base}limpieza`, label: 'Limpieza', key: 'limpieza' },
  { href: `${base}jardineria`, label: 'Jardinería', key: 'jardineria' },
  { href: `${base}mantenimiento`, label: 'Mantenimiento', key: 'mantenimiento' },
];
---
<header class="site-header">
  <div class="container">
    <a href={base} class="brand">
      <img class="brand-logo" src={`${base}logo/logo-horizontal.png`} alt="SIAC — Servicios Integrales en Administración de Condominios">
    </a>
    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={current === link.key ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
      <a class="nav-cta" href={`${base}condominios`} aria-current={current === 'condominios' ? 'page' : undefined}>Condominios</a>
    </nav>
    <div class="header-actions">
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar a modo oscuro">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.5A8.5 8.5 0 1111.5 3 7 7 0 0021 12.5z"/></svg>
      </button>
      <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-mobile">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
  <div class="nav-mobile" id="nav-mobile">
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      <li><a href={`${base}contacto`}>Contáctenos</a></li>
      <li><a class="nav-cta" href={`${base}condominios`}>Condominios</a></li>
    </ul>
  </div>
</header>
