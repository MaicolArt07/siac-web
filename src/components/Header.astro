---
export interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { href: base, label: 'Inicio', key: 'inicio' },
  { href: `${base}nosotros`, label: 'Nosotros', key: 'nosotros' },
  { href: `${base}administracion`, label: 'Administración', key: 'administracion' },
  { href: `${base}seguridad`, label: 'Seguridad', key: 'seguridad' },
  { href: `${base}limpieza`, label: 'Limpieza', key: 'limpieza' },
  { href: `${base}jardineria`, label: 'Jardinería', key: 'jardineria' },
  { href: `${base}mantenimiento`, label: 'Mantenimiento', key: 'mantenimiento' },
];
---
<header class="site-header">
  <div class="container">
    <a href={base} class="brand">
      <img class="brand-logo" src={`${base}logo/logo-horizontal.png`} alt="SIAC — Servicios Integrales en Administración de Condominios">
    </a>
    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={current === link.key ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
      <a class="nav-cta" href={`${base}condominios`} aria-current={current === 'condominios' ? 'page' : undefined}>Condominios</a>
    </nav>
    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-mobile">☰</button>
  </div>
  <div class="nav-mobile" id="nav-mobile">
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      <li><a href={`${base}contacto`}>Contáctenos</a></li>
      <li><a class="nav-cta" href={`${base}condominios`}>Condominios</a></li>
    </ul>
  </div>
</header>
