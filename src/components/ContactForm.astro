---
// Formulario de contacto reutilizable (página /contacto y modal flotante).
// Sin backend: al enviar arma un mensaje y lo abre en WhatsApp (ver js/main.js).
export interface Props {
  prefix?: string;
  compact?: boolean;
}
import { WHATSAPP_NUMBER } from '../config/site';
const { prefix = 'cf', compact = false } = Astro.props;
const id = (name: string) => `${prefix}-${name}`;
---
<form class:list={['contact-form', { 'form-card': !compact }]} data-contact-form data-wa={WHATSAPP_NUMBER}>
  <div class="field-row">
    <div class="field">
      <label for={id('nombre')}>Nombre completo</label>
      <input type="text" id={id('nombre')} name="nombre" autocomplete="name" required>
    </div>
    <div class="field">
      <label for={id('telefono')}>Teléfono / WhatsApp</label>
      <input type="tel" id={id('telefono')} name="telefono" autocomplete="tel">
    </div>
  </div>
  <div class="field">
    <label for={id('email')}>Correo electrónico</label>
    <input type="email" id={id('email')} name="email" autocomplete="email" required>
  </div>
  <div class="field-row">
    <div class="field">
      <label for={id('condominio')}>Condominio / edificio</label>
      <input type="text" id={id('condominio')} name="condominio">
    </div>
    <div class="field">
      <label for={id('servicio')}>Servicio de interés</label>
      <select id={id('servicio')} name="servicio">
        <option>Administración</option>
        <option>Seguridad</option>
        <option>Limpieza</option>
        <option>Jardinería</option>
        <option>Mantenimiento de piscina</option>
        <option>Varios servicios</option>
      </select>
    </div>
  </div>
  <div class="field">
    <label for={id('mensaje')}>Mensaje</label>
    <textarea id={id('mensaje')} name="mensaje" rows={compact ? 3 : 4}></textarea>
  </div>
  <button class="btn btn-primary btn-block" type="submit">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 1.9 17.7L.3 23.7l6.2-1.6A11.8 11.8 0 0 0 24 12a11.7 11.7 0 0 0-3.5-8.5zM12 21.6c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.6zm5.4-7.3c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8 8 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.5 13.5 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.1-.3-.2-.6-.3z"/></svg>
    Enviar solicitud por WhatsApp
  </button>
  <p class="form-hint">Se abrirá WhatsApp con su mensaje listo para enviar.</p>
</form>
