---
const base = import.meta.env.BASE_URL;
---
<div class="topbar">
  <div class="container">
    <div class="topbar-info">
      <span>📍 Santa Cruz, Bolivia</span>
      <a href={`${base}contacto`}>✉ Escríbanos</a>
    </div>
    <div class="topbar-social">
      <a href="https://www.facebook.com/siac.scz" aria-label="Facebook">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13 22v-8h2.7l.4-3H13V9c0-.9.2-1.5 1.6-1.5H16V4.9c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V11H7.5v3H9.8v8H13z"/></svg>
      </a>
      <a href={`${base}condominios`} aria-label="Portal condominio">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="14" rx="1"/><path d="M3 8h18"/></svg>
      </a>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar a modo oscuro">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.5A8.5 8.5 0 1111.5 3 7 7 0 0021 12.5z"/></svg>
      </button>
    </div>
  </div>
</div>
