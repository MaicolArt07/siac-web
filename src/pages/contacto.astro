---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout
  title="Contáctenos — SIAC"
  description="Escríbanos para solicitar una propuesta de administración para su condominio o edificio."
  current="contacto"
>
<section class="page-hero">
  <div class="container">
    <p class="breadcrumb"><a href={base}>Inicio</a> / Contáctenos</p>
    <span class="mono-tag">Hablemos</span>
    <h1>Contáctenos</h1>
    <p>Responda unos datos básicos y le preparamos una propuesta de administración a medida.</p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <form class="form-card" action="#" method="post">
      <div class="field">
        <label for="nombre">Nombre completo</label>
        <input type="text" id="nombre" name="nombre" required>
      </div>
      <div class="field">
        <label for="condominio">Condominio / edificio</label>
        <input type="text" id="condominio" name="condominio">
      </div>
      <div class="field">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="field">
        <label for="telefono">Teléfono / WhatsApp</label>
        <input type="tel" id="telefono" name="telefono">
      </div>
      <div class="field">
        <label for="servicio">Servicio de interés</label>
        <select id="servicio" name="servicio">
          <option>Administración (ADCOM-SIAC)</option>
          <option>Seguridad</option>
          <option>Limpieza</option>
          <option>Jardinería</option>
          <option>Mantenimiento de piscina</option>
          <option>Varios servicios</option>
        </select>
      </div>
      <div class="field">
        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4"></textarea>
      </div>
      <button class="btn btn-primary" type="submit" style="width:100%; justify-content:center">Enviar solicitud</button>
    </form>
    <div>
      <span class="mono-tag">Otros canales</span>
      <h2 style="margin-top:.4rem">Mientras confirmamos los datos oficiales</h2>
      <p style="margin-top: var(--space-2); color: var(--text-secondary)">El sitio original de SIAC no publica teléfono, correo ni dirección física. Escríbanos por Facebook mientras se confirman los canales directos de atención.</p>
      <ul class="checklist" style="margin-top: var(--space-3)">
        <li><span class="tick">✓</span><span><a href="https://www.facebook.com/siac.scz" style="text-decoration: underline">Facebook — Servicios Integrales en Administración de Condominio SIAC</a></span></li>
        <li><span class="tick">✓</span><span>Copropietarios: ingrese al <a href={`${base}condominios`} style="text-decoration: underline">portal de condominio</a> para su estado de cuenta.</span></li>
      </ul>
    </div>
  </div>
</section>
</Layout>
