---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

// activo: true  → SIAC lo administra actualmente (botón "Ingresar").
// activo: false → tarjeta "En construcción" SIN nombre ni logo del condominio
//                 (no publicar datos de condominios que SIAC no administra).
const condominios = [
  { nombre: 'Ingavi', logo: `${base}logo/logo-ingavi.png`, activo: true },
  { nombre: 'Sevilla Sur I', logo: `${base}logo/logo-suri.jpg`, activo: true },
  { nombre: 'Marbella', logo: `${base}logo/logo-marbella.jpg`, activo: true },
  { nombre: 'Portales', logo: `${base}logo/logo-portales.png`, activo: true },
  { activo: false },
  { activo: false },
  { activo: false },
];
---
<Layout
  title="Condominios — SIAC"
  description="Seleccione su condominio para ingresar al Sistema Integral de Administración de Condominios."
  current="condominios"
>
<section class="condo-hero">
  <div class="container">
    <h1>Condominios SIAC</h1>
    <p>Seleccione su condominio para ingresar al sistema.</p>
    <div class="condo-search">
      <input type="search" id="condo-search-input" placeholder="Buscar condominio..." aria-label="Buscar condominio">
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="condo-grid" id="condo-grid">
      {condominios.map((condo, i) => (
        <div class:list={['condo-card', { 'is-soon': !condo.activo }]} data-name={condo.activo ? condo.nombre.toLowerCase() : 'nuevo condominio'}>
          {!condo.activo && <span class="condo-badge">En construcción</span>}
          {condo.activo ? (
            <div class="condo-logo"><img src={condo.logo} alt={`Logo de Condominio ${condo.nombre}`} loading="lazy"></div>
          ) : (
            <div class="condo-logo condo-logo-soon" role="img" aria-label="Acceso en construcción">
              <svg viewBox="0 0 120 80" width="120" height="80" aria-hidden="true">
                <!-- casco -->
                <path d="M38 34a22 22 0 0 1 44 0v4H38z" fill="#f2a516"/>
                <path d="M56 13h8v21h-8z" fill="#d98a00"/>
                <rect x="32" y="37" width="56" height="6" rx="3" fill="#d98a00"/>
                <!-- barrera -->
                <rect x="14" y="50" width="92" height="14" rx="2" fill="#fff"/>
                <clipPath id={`barrier-${i}`}><rect x="14" y="50" width="92" height="14" rx="2"/></clipPath>
                <g clip-path={`url(#barrier-${i})`} fill="#f2a516">
                  <path d="M10 64l14-14h10L20 64zM34 64l14-14h10L44 64zM58 64l14-14h10L68 64zM82 64l14-14h10L92 64z"/>
                </g>
                <rect x="14" y="50" width="92" height="14" rx="2" fill="none" stroke="#7a5300" stroke-width="1.5"/>
                <rect x="22" y="64" width="5" height="12" fill="#7a5300"/>
                <rect x="93" y="64" width="5" height="12" fill="#7a5300"/>
              </svg>
            </div>
          )}
          <h3>{condo.activo ? condo.nombre.toUpperCase() : 'NUEVO CONDOMINIO'}</h3>
          {condo.activo ? (
            <>
              <p>Sistema Integral de Administración de Condominios.</p>
              <a class="btn btn-blue" href="https://condominios.siac.com.bo/login">Ingresar</a>
            </>
          ) : (
            <>
              <p>Este acceso estará disponible próximamente.</p>
              <span class="btn btn-disabled" aria-disabled="true">Próximamente</span>
            </>
          )}
        </div>
      ))}
    </div>
    <p class="condo-empty" id="condo-empty">No encontramos un condominio con ese nombre.</p>
  </div>
</section>

<script>
  const input = document.getElementById('condo-search-input');
  const cards = Array.from(document.querySelectorAll('.condo-card'));
  const empty = document.getElementById('condo-empty');

  input?.addEventListener('input', () => {
    const term = input.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const match = card.getAttribute('data-name')?.includes(term);
      card.classList.toggle('is-hidden', !match);
      if (match) visible++;
    });
    empty?.classList.toggle('is-visible', visible === 0);
  });
</script>
</Layout>
